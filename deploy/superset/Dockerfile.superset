# Secondary (Docker) route for the Superset prototype: the official image plus the DuckDB SQLAlchemy driver
# that duckdb-engine provides, so the container can read data/out/stapfer_stats.duckdb (mounted read-only).
#
# Built and run on omen (single container, SQLite metadata; see README "Route C").
FROM apache/superset:6.1.0

USER root
# Superset runs from /app/.venv, which has no pip: a plain `pip install` lands in the system Python and Superset
# never sees the driver ("Connection failed"). Install into the venv with the image's uv instead.
RUN uv pip install --no-cache --python /app/.venv/bin/python "duckdb-engine==0.17.0"
USER superset
