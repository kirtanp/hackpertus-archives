{
  "name": "archai-presentation",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "setup": "rm -rf public/reveal && mkdir -p public && cp -rL node_modules/reveal.js public/reveal",
    "dev": "bun run setup && astro dev",
    "build": "bun run setup && astro build",
    "preview": "bun run setup && astro preview",
    "build:single": "bun run setup && SINGLE_FILE=1 bunx astro build && bun scripts/single-file.mjs",
    "check": "astro check"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "7.3.3",
    "reveal.js": "^6.0.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "typescript": "^6.0.2"
  }
}
