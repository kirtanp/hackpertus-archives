---
// The site root is the deck itself: the first deck in presentation order
// renders at `/`, with no intervening index page. The deck index lives at
// `/decks/` and every deck also keeps its own `/slides/<id>/` route.
import SlideLayout from "../layouts/SlideLayout.astro";
import { deckBody, sortedDecks } from "../lib/decks";

const decks = await sortedDecks();
if (decks.length === 0) {
  throw new Error("no deck in src/content/slides to render at the site root");
}

const deck = decks[0];
const { data } = deck;
---

<SlideLayout
  title={data.title}
  theme={data.theme}
  transition={data.transition}
  controls={data.controls}
  progress={data.progress}
  pubDate={data.pubDate}
  body={deckBody(deck)}
  fontScale={data.fontScale}
/>
