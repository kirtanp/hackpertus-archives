.venv/
__pycache__/
.pytest_cache/
.ipynb_checkpoints/
.playwright-mcp/
.DS_Store
# secrets
.env
*.env
!.env.example
# raw dumps and intermediate tables (3.6 GB; download from opendata.swiss, see README)
data/raw/
data/interim/
# facsimile scans: not redistributable (Bundesarchiv copyright), never commit
data/facsimiles/
data/facsimiles_png/
# derived build artifact: the DuckDB datasource Apache Superset reads, rebuilt from the corpus parquet
# with `just statssql`; the committed corpus is data/out/stapfer_answers.parquet, not this file
data/out/*.duckdb
# Astro Starlight documentation site (docs/): an isolated bun toolchain, its caches and its build output;
# `docs/bun.lock` is committed (CI installs with --frozen-lockfile) and `docs/public/` holds the shipped assets
docs/node_modules/
docs/dist/
docs/.astro/
# slide deck (presentation/): its own bun toolchain, separate from the Python one above;
# `presentation/bun.lock` is committed and `public/reveal/` is copied from node_modules on every build
presentation/node_modules/
presentation/dist/
presentation/dist-single/
presentation/single/
presentation/public/reveal/
presentation/.astro/
# Apache Superset prototype (deploy/superset): its virtualenv, metadata database and generated secret
deploy/superset/.venv/
deploy/superset/*.db
deploy/superset/superset_config.py

# LLM model benchmark output (scripts/model-bench.sh)
bench-out/
