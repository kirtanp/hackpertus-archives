# Copy to .env (never commit .env). Without a key the app answers extractively (cited passages, no generated text).
APERTUS_BASE_URL=https://gateway.keera.ch/api/v1
APERTUS_MODEL=apertus-v1-5-70b
APERTUS_API_KEY=
# dynamic | apertus | off — Apertus query rewriting before retrieval (measured in data/out/qa_eval.json)
QA_REWRITE=dynamic
